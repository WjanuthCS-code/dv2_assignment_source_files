{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth: number of EPBC-listed threatened or extinct frog species known or likely to occur in each state/territory.",
  "title": {
    "text": "Threatened frogs are concentrated in the east",
    "subtitle": ["Number of nationally listed frog species in each state or territory.", "Eastern states also have more frog species overall, so higher", "counts partly reflect richer frog life."]
  },
  "width": "container",
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9e6da",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/epbc_threatened_species_2026-08-28.csv"
      },
      "transform": [
        {
          "filter": "datum.Class == 'Amphibia'"
        },
        {
          "fold": [
            "ACT",
            "NSW",
            "NT",
            "QLD",
            "SA",
            "TAS",
            "VIC",
            "WA"
          ],
          "as": [
            "abbr",
            "occurs"
          ]
        },
        {
          "filter": "datum.occurs == 'Yes'"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "abbr"
          ]
        },
        {
          "calculate": "{'ACT': 'Australian Capital Territory', 'NSW': 'New South Wales', 'NT': 'Northern Territory', 'QLD': 'Queensland', 'SA': 'South Australia', 'TAS': 'Tasmania', 'VIC': 'Victoria', 'WA': 'Western Australia'}[datum.abbr]",
          "as": "state"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/australia_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.STATE_NAME"
          },
          "as": "geo"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "geoshape",
            "stroke": "#ffffff",
            "strokeWidth": 1.2
          },
          "encoding": {
            "shape": {
              "field": "geo",
              "type": "geojson"
            },
            "color": {
              "field": "n",
              "type": "quantitative",
              "title": "Threatened frog species",
              "scale": {
                "type": "threshold",
                "domain": [
                  5,
                  10,
                  20
                ],
                "range": [
                  "#fde5cc",
                  "#f8b07a",
                  "#e0632b",
                  "#a83a10"
                ]
              },
              "legend": {"orient": "top-left", "direction": "horizontal", "offset": 0, "labelExpr": "datum.index == 0 ? '1–4' : datum.index == 1 ? '5–9' : datum.index == 2 ? '10–19' : '20+'"}
            },
            "tooltip": [
              {
                "field": "state",
                "type": "nominal",
                "title": "State / territory"
              },
              {
                "field": "n",
                "type": "quantitative",
                "title": "Threatened frog species"
              }
            ]
          }
        },
        {
          "description": "State labels. Label positions are hand-placed annotation coordinates.",
          "transform": [
            {
              "lookup": "abbr",
              "from": {
                "data": {
                  "values": [
                    {
                      "abbr": "WA",
                      "lon": 122,
                      "lat": -25.5
                    },
                    {
                      "abbr": "NT",
                      "lon": 133.4,
                      "lat": -19.8
                    },
                    {
                      "abbr": "SA",
                      "lon": 135.2,
                      "lat": -30.2
                    },
                    {
                      "abbr": "QLD",
                      "lon": 144.6,
                      "lat": -22.5
                    },
                    {
                      "abbr": "NSW",
                      "lon": 146.6,
                      "lat": -32.4
                    },
                    {
                      "abbr": "VIC",
                      "lon": 144.2,
                      "lat": -37
                    },
                    {
                      "abbr": "TAS",
                      "lon": 146.6,
                      "lat": -42
                    },
                    {
                      "abbr": "ACT",
                      "lon": 153.6,
                      "lat": -36.6
                    }
                  ]
                },
                "key": "abbr",
                "fields": [
                  "lon",
                  "lat"
                ]
              }
            },
            {
              "calculate": "datum.abbr + '  ' + datum.n",
              "as": "label"
            }
          ],
          "mark": {
            "type": "text",
            "fontWeight": 700,
            "fontSize": 13
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            },
            "color": {
              "condition": {
                "test": "datum.n >= 20",
                "value": "#ffffff"
              },
              "value": "#1e2b23"
            }
          }
        }
      ]
    }
  ]
}