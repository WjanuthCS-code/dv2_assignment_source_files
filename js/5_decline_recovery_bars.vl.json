{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging bar chart: for each threatened frog species, the number of monitoring sites where the last count was lower (left) or higher (right) than the first count. Calculated from the TSX monitoring time series.",
  "title": {
    "text": "Corroboree and Baw Baw frogs fell at most of their monitoring sites",
    "subtitle": ["For each monitoring site, the latest survey count is compared with the first (surveys span 1950–2022).", "Species with at least 5 sites that changed; sites with no change are not shown."]
  },
  "data": {"url": "data/tsx_frog_timeseries.csv"},
  "transform": [
    {"fold": ["1950", "1951", "1952", "1953", "1954", "1955", "1956", "1957", "1958", "1959", "1960", "1961", "1962", "1963", "1964", "1965", "1966", "1967", "1968", "1969", "1970", "1971", "1972", "1973", "1974", "1975", "1976", "1977", "1978", "1979", "1980", "1981", "1982", "1983", "1984", "1985", "1986", "1987", "1988", "1989", "1990", "1991", "1992", "1993", "1994", "1995", "1996", "1997", "1998", "1999", "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022"], "as": ["year", "count"]},
    {"filter": "isValid(datum.count) && datum.count !== ''"},
    {"calculate": "toNumber(datum.year)", "as": "yr"},
    {"calculate": "toNumber(datum.count)", "as": "count_num"},
    {
      "aggregate": [
        {"op": "argmin", "field": "yr", "as": "first"},
        {"op": "argmax", "field": "yr", "as": "last"},
        {"op": "count", "as": "n_years"}
      ],
      "groupby": ["TimeSeriesID", "CommonName", "FunctionalGroup", "Region", "RegionCentroidLatitude", "RegionCentroidLongitude", "State"]
    },
    {"filter": "datum.n_years >= 2"},
    {
      "calculate": "datum.last.count_num > datum.first.count_num ? 'Increased' : datum.last.count_num < datum.first.count_num ? 'Decreased' : 'No change'",
      "as": "trend"
    },
    {"filter": "datum.trend != 'No change'"},
    {"aggregate": [{"op": "count", "as": "sites"}], "groupby": ["CommonName", "FunctionalGroup", "trend"]},
    {"calculate": "datum.trend == 'Decreased' ? -datum.sites : datum.sites", "as": "signed"},
    {"joinaggregate": [{"op": "sum", "field": "sites", "as": "total"}, {"op": "sum", "field": "signed", "as": "net"}], "groupby": ["CommonName"]},
    {"calculate": "datum.net / datum.total", "as": "net_share"},
    {"filter": "datum.total >= 5"},
    {"calculate": "indexof(datum.FunctionalGroup, 'non-impacted') >= 0 ? 'Not affected' : 'Affected'", "as": "chytrid"}
  ],
  "hconcat": [
    {
      "width": 70,
      "height": {"step": 26},
      "transform": [{"filter": "datum.trend == 'Decreased' || datum.trend == 'Increased'"}],
      "title": {"text": "Chytrid?", "fontSize": 12, "font": "'Source Sans 3', Helvetica, Arial, sans-serif", "fontWeight": 600, "anchor": "middle", "color": "#3d4a41", "subtitle": null},
      "mark": {"type": "text", "fontSize": 12},
      "encoding": {
        "y": {"field": "CommonName", "type": "nominal", "sort": {"field": "net_share", "op": "min", "order": "ascending"}, "axis": null},
        "text": {"field": "chytrid"},
        "color": {"condition": {"test": "datum.chytrid == 'Affected'", "value": "#a50f15"}, "value": "#5c6b61"}
      }
    },
    {
      "width": 580,
      "height": {"step": 26},
      "layer": [
        {
          "mark": {"type": "bar", "cornerRadius": 2, "height": {"band": 0.7}},
          "encoding": {
            "y": {
              "field": "CommonName", "type": "nominal", "title": null,
              "sort": {"field": "net_share", "op": "min", "order": "ascending"},
              "axis": {"labelFontSize": 13, "labelColor": "#1e2b23", "domain": false, "ticks": false, "labelPadding": 8, "labelLimit": 220}
            },
            "x": {
              "field": "signed", "type": "quantitative",
              "title": "Number of monitoring sites",
              "axis": {"labelExpr": "abs(datum.value)", "tickCount": 8, "titlePadding": 10}
            },
            "color": {
              "field": "trend", "type": "nominal", "title": null,
              "scale": {"domain": ["Decreased", "Increased"], "range": ["#c0392b", "#2a78b5"]},
              "legend": {"orient": "top", "direction": "horizontal", "labelExpr": "datum.label == 'Decreased' ? 'Fewer frogs than at first count' : 'More frogs than at first count'", "symbolType": "square", "offset": 22}
            },
            "tooltip": [
              {"field": "CommonName", "title": "Species"},
              {"field": "trend", "title": "Latest count vs first"},
              {"field": "sites", "title": "Sites", "type": "quantitative"},
              {"field": "total", "title": "Sites with a change", "type": "quantitative"},
              {"field": "chytrid", "title": "Affected by chytrid"}
            ]
          }
        },
        {
          "transform": [{"filter": "datum.signed < 0"}],
          "mark": {"type": "text", "fontSize": 11, "fontWeight": 600, "align": "right", "dx": -5, "color": "#3d4a41"},
          "encoding": {
            "y": {"field": "CommonName", "type": "nominal", "sort": {"field": "net_share", "op": "min", "order": "ascending"}},
            "x": {"field": "signed", "type": "quantitative"},
            "text": {"field": "sites"}
          }
        },
        {
          "transform": [{"filter": "datum.signed > 0"}],
          "mark": {"type": "text", "fontSize": 11, "fontWeight": 600, "align": "left", "dx": 5, "color": "#3d4a41"},
          "encoding": {
            "y": {"field": "CommonName", "type": "nominal", "sort": {"field": "net_share", "op": "min", "order": "ascending"}},
            "x": {"field": "signed", "type": "quantitative"},
            "text": {"field": "sites"}
          }
        },
        {
          "mark": {"type": "rule", "color": "#3d4a41", "strokeWidth": 1},
          "encoding": {"x": {"datum": 0}}
        }
      ]
    }
  ],
  "spacing": 4,
  "resolve": {"scale": {"y": "shared"}}
}
