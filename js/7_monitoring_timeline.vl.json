{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: number of TSX monitoring sites with a survey count for each threatened frog species in each year (1985-2022).",
  "title": {
    "text": "Gaps in the record",
    "subtitle": "Number of sites where each threatened frog was counted, by year. Blank years mean no usable survey data for that species."
  },
  "width": "container",
  "height": {"step": 15},
  "data": {"url": "data/tsx_frog_timeseries.csv"},
  "transform": [
    {"fold": ["1950", "1951", "1952", "1953", "1954", "1955", "1956", "1957", "1958", "1959", "1960", "1961", "1962", "1963", "1964", "1965", "1966", "1967", "1968", "1969", "1970", "1971", "1972", "1973", "1974", "1975", "1976", "1977", "1978", "1979", "1980", "1981", "1982", "1983", "1984", "1985", "1986", "1987", "1988", "1989", "1990", "1991", "1992", "1993", "1994", "1995", "1996", "1997", "1998", "1999", "2000", "2001", "2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022"], "as": ["year", "count"]},
    {"filter": "isValid(datum.count) && datum.count !== ''"},
    {"calculate": "toNumber(datum.year)", "as": "yr"},
    {"filter": "datum.yr >= 1985"},
    {"aggregate": [{"op": "count", "as": "sites"}], "groupby": ["CommonName", "yr", "MaxStatus"]},
    {"joinaggregate": [{"op": "min", "field": "yr", "as": "first_year"}], "groupby": ["CommonName"]}
  ],
  "mark": {"type": "rect", "stroke": "#f6f4ec", "strokeWidth": 1},
  "encoding": {
    "x": {
      "field": "yr", "type": "ordinal", "title": null,
      "scale": {"domain": [1985, 1986, 1987, 1988, 1989, 1990, 1991, 1992, 1993, 1994, 1995, 1996, 1997, 1998, 1999, 2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022]},
      "axis": {"labelExpr": "datum.value % 5 == 0 ? datum.value : ''", "labelAngle": 0, "ticks": false, "domain": false}
    },
    "y": {
      "field": "CommonName", "type": "nominal", "title": null,
      "sort": {"field": "first_year", "op": "min", "order": "ascending"},
      "axis": {"ticks": false, "domain": false, "labelFontSize": 11.5, "labelColor": "#1e2b23", "labelLimit": 200}
    },
    "color": {
      "field": "sites", "type": "quantitative", "title": "Sites surveyed",
      "scale": {"type": "threshold", "domain": [2, 5, 20, 50], "range": ["#d4e3cf", "#9cc39a", "#5e9b63", "#2f6b3a", "#163d22"]},
      "legend": {"orient": "top", "direction": "horizontal", "labelExpr": "datum.index == 0 ? '1' : datum.index == 1 ? '2–4' : datum.index == 2 ? '5–19' : datum.index == 3 ? '20–49' : '50+'"}
    },
    "tooltip": [
      {"field": "CommonName", "title": "Species"},
      {"field": "MaxStatus", "title": "Status"},
      {"field": "yr", "title": "Year"},
      {"field": "sites", "title": "Sites counted", "type": "quantitative"}
    ]
  }
}
