{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small-multiple gridded maps: FrogID recordings of the seven featured native frogs, counted in 1-degree grid cells, for each season.",
  "title": {
    "text": "The chorus rises in spring and summer",
    "subtitle": "Eastern Australia. FrogID recordings of the seven featured native frogs, counted in 1° grid cells (about 100 km across)"
  },
  "hconcat": [
    {
      "title": {
        "text": "Summer (Dec–Feb)",
        "fontSize": 14,
        "anchor": "middle",
        "subtitle": null
      },
      "width": 228,
      "height": 330,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -133,
          0
        ],
        "fit": {
          "type": "MultiPoint",
          "coordinates": [
            [
              139,
              -10.5
            ],
            [
              154,
              -43.8
            ]
          ]
        }
      },
      "layer": [
        {
          "data": {
            "url": "data/australia_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#e2dfd2",
            "stroke": "#ffffff",
            "strokeWidth": 0.7,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/frogid_featured_records.csv"
          },
          "transform": [
            {
              "filter": "datum.Species != 'Rhinella marina'"
            },
            {
              "filter": "datum.Month == 12 || datum.Month <= 2"
            },
            {
              "calculate": "floor(datum['Decimal longitude (WGS84)'])",
              "as": "lon0"
            },
            {
              "calculate": "floor(datum['Decimal latitude (WGS84)'])",
              "as": "lat0"
            },
            {
              "aggregate": [
                {
                  "op": "count",
                  "as": "calls"
                }
              ],
              "groupby": [
                "lon0",
                "lat0"
              ]
            },
            {
              "calculate": "datum.lon0 + 1",
              "as": "lon1"
            },
            {
              "calculate": "datum.lat0 + 1",
              "as": "lat1"
            }
          ],
          "mark": {
            "type": "rect",
            "clip": true,
            "stroke": "#ffffff",
            "strokeWidth": 0.3
          },
          "encoding": {
            "longitude": {
              "field": "lon0",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat0",
              "type": "quantitative"
            },
            "color": {
              "field": "calls",
              "type": "quantitative",
              "title": "Recordings per grid cell",
              "scale": {
                "type": "threshold",
                "domain": [
                  10,
                  50,
                  200,
                  500
                ],
                "range": [
                  "#cfe3c6",
                  "#94c48c",
                  "#4f9a5a",
                  "#2a6b36",
                  "#123d1f"
                ]
              },
              "legend": {
                "labelExpr": "datum.index == 0 ? '1–9' : datum.index == 1 ? '10–49' : datum.index == 2 ? '50–199' : datum.index == 3 ? '200–499' : '500+'"
              }
            },
            "tooltip": [
              {
                "field": "calls",
                "title": "Recordings in this 1° cell",
                "type": "quantitative",
                "format": ","
              },
              {
                "field": "lon0",
                "title": "Longitude from"
              },
              {
                "field": "lat0",
                "title": "Latitude from"
              }
            ],
            "longitude2": {
              "field": "lon1"
            },
            "latitude2": {
              "field": "lat1"
            }
          }
        }
      ]
    },
