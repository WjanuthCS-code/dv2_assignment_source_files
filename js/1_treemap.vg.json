{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap of the 214 native frog species recorded by FrogID, nested by family and then by national (EPBC Act) threat status. Box area = number of species.",
  "height": 440,
  "padding": {
    "top": 4,
    "left": 0,
    "right": 0,
    "bottom": 4
  },
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "title": {
    "text": "Which frog families hold the threatened species?",
    "subtitle": "214 native frog species recorded by FrogID. Each family is split by national threat status; box area = number of species. Hover for details."
  },
  "signals": [
    {
      "name": "width",
      "init": "containerSize()[0] > 0 ? containerSize()[0] : 1000",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0] > 0 ? containerSize()[0] : width"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "epbc",
      "url": "data/epbc_threatened_species_2026-08-28.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Class === 'Amphibia'"
        },
        {
          "type": "formula",
          "as": "species_key",
          "expr": "datum.Genus + ' ' + datum.Species"
        }
      ]
    },
    {
      "name": "epbc_subspecies",
      "source": "epbc",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Infraspecies !== '-' && datum.Infraspecies !== ''"
        },
        {
          "type": "aggregate",
          "groupby": [
            "species_key"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "n_subspecies"
          ]
        }
      ]
    },
    {
      "name": "species",
      "url": "data/frogid_species_counts.csv",
      "format": {
        "type": "csv",
        "parse": {
          "Number of records": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum['Species Name'] !== 'Rhinella marina'"
        },
        {
          "type": "lookup",
          "from": "epbc",
          "key": "Scientific Name",
          "fields": [
            "Species Name"
          ],
          "values": [
            "Threatened status"
          ],
          "as": [
            "status"
          ]
        },
        {
          "type": "lookup",
          "from": "epbc_subspecies",
          "key": "species_key",
          "fields": [
            "Species Name"
          ],
          "values": [
            "n_subspecies"
          ],
          "as": [
            "n_subspecies"
          ]
        },
        {
          "type": "formula",
          "as": "status",
          "expr": "datum.status ? datum.status : (datum.n_subspecies ? 'Subspecies listed' : 'Not nationally listed')"
        },
        {
          "type": "formula",
          "as": "family_label",
          "expr": "{'Pelodryadidae': 'Tree frogs', 'Myobatrachidae': 'Froglets & toadlets', 'Limnodynastidae': 'Marsh & burrowing frogs', 'Microhylidae': 'Nursery frogs', 'Ranidae': 'Wood Frog'}[datum.Family] || datum.Family"
        }
      ]
    },
    {
      "name": "groups",
      "source": "species",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Family",
            "family_label",
            "status"
          ],
          "fields": [
            null,
            "Number of records"
          ],
          "ops": [
            "count",
            "argmax"
          ],
          "as": [
            "n_species",
            "top"
          ]
        },
        {
          "type": "formula",
          "as": "top_name",
          "expr": "datum.top['Vernacular Name']"
        },
        {
          "type": "formula",
          "as": "order",
          "expr": "indexof(['Not nationally listed', 'Subspecies listed', 'Vulnerable', 'Endangered', 'Critically Endangered'], datum.status)"
        }
      ]
    },
    {
      "name": "family_totals",
      "source": "species",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "family_label"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "tree",
      "source": "groups",
      "transform": [
        {
          "type": "nest",
          "keys": [
            "family_label"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "n_species",
          "sort": {
            "field": [
              "value",
              "order"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.2,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 2,
          "paddingOuter": 0,
          "paddingTop": 24,
          "paddingRight": 3
        }
      ]
    },
    {
      "name": "families",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        },
        {
          "type": "lookup",
          "from": "family_totals",
          "key": "family_label",
          "fields": [
            "key"
          ],
          "values": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Not nationally listed",
        "Subspecies listed",
        "Vulnerable",
        "Endangered",
        "Critically Endangered"
      ],
      "range": [
        "#dfe5d8",
        "#c9b48a",
        "#eba92a",
        "#d9582a",
        "#a50f15"
      ]
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "National threat status (EPBC Act)",
      "orient": "top",
      "direction": "horizontal",
      "symbolType": "square",
      "symbolSize": 140,
      "columnPadding": 16,
      "offset": 8
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "families"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#2f6b3a"
          },
          "fillOpacity": {
            "value": 0.12
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "families"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 16"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 150 ? datum.key + ' · ' + datum.total + ' species' : (datum.x1 - datum.x0) > 60 ? datum.key : ''"
          },
          "font": {
            "value": "Fraunces, Georgia, serif"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#1e2b23"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 8"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#f6f4ec"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "color",
            "field": "status"
          },
          "tooltip": {
            "signal": "{'title': datum.family_label + ' (' + datum.Family + ')', 'Status': datum.status, 'Species': datum.n_species, 'Most-recorded species in this group': datum.top_name}"
          }
        },
        "hover": {
          "stroke": {
            "value": "#1e2b23"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 18"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 34 && (datum.y1 - datum.y0) > 22 ? '' + datum.n_species : ''"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "signal": "datum.status === 'Critically Endangered' || datum.status === 'Endangered' ? '#ffffff' : '#1e2b23'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 6"
          },
          "y": {
            "signal": "datum.y0 + 33"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 110 && (datum.y1 - datum.y0) > 40 ? (datum.status === 'Not nationally listed' ? 'not listed' : lower(datum.status)) : ''"
          },
          "fontSize": {
            "value": 11.5
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 10"
          },
          "fill": {
            "signal": "datum.status === 'Critically Endangered' || datum.status === 'Endangered' ? '#ffffff' : '#3d4a41'"
          }
        }
      }
    }
  ]
}